{
  "compilerOptions": {
    "baseUrl": ".",
    "declaration": true,
    "module": "Node16",
    "outDir": "dist",
    "paths": {
      "@src/*": ["./src/*"]
    },
    "rootDir": "src",
    "strict": true,
    "target": "es2022",
    "moduleResolution": "node16",
    "types": ["node"]
  },
  "include": ["./src/**/*"],
  "ts-node": {
    "esm": true
  }
}
