{
  "name": "scribemuse",
  "description": "An agentic CLI for crafting and publishing content workflows.",
  "version": "0.0.0",
  "author": "Satoshi Konno",
  "bin": {
    "scribemuse": "./bin/run.js"
  },
  "bugs": "https://github.com/cybergarage/scribemuse/issues",
  "dependencies": {
    "@oclif/core": "^4",
    "@oclif/plugin-help": "^6",
    "@oclif/plugin-plugins": "^5",
    "env-paths": "^4.0.0",
    "ollama": "^0.6.3"
  },
  "devDependencies": {
    "@eslint/compat": "^1",
    "@oclif/prettier-config": "^0.2.1",
    "@oclif/test": "^4",
    "@types/chai": "^4",
    "@types/mocha": "^10",
    "@types/node": "^18",
    "@types/sinon": "^21.0.0",
    "chai": "^4",
    "eslint": "^9",
    "eslint-config-oclif": "^6",
    "eslint-config-prettier": "^10",
    "mocha": "^10",
    "oclif": "^4",
    "prettier": "^3.8.1",
    "shx": "^0.3.3",
    "sinon": "^21.0.2",
    "ts-node": "^10",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "./bin",
    "./dist",
    "./oclif.manifest.json"
  ],
  "homepage": "https://github.com/cybergarage/scribemuse",
  "keywords": [
    "oclif"
  ],
  "license": "Apache License 2.0",
  "main": "dist/index.js",
  "type": "module",
  "oclif": {
    "bin": "scribemuse",
    "dirname": "scribemuse",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-plugins"
    ],
    "topicSeparator": " ",
    "topics": {
      "hello": {
        "description": "Say hello to the world and others"
      }
    }
  },
  "repository": "cybergarage/scribemuse",
  "scripts": {
    "build": "shx rm -rf dist && tsc -b",
    "headers:apply": "node ./bin/headers.js --write",
    "headers:check": "node ./bin/headers.js",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint --fix",
    "postpack": "shx rm -f oclif.manifest.json",
    "prepack": "oclif manifest && oclif readme",
    "pretest": "npm run format && npm run lint",
    "test": "mocha --forbid-only \"test/**/*.test.ts\"",
    "version": "oclif readme && git add README.md"
  },
  "types": "dist/index.d.ts",
  "prettier": "@oclif/prettier-config"
}
