{
  "name": "orbit",
  "description": "An agentic CLI for crafting and publishing content workflows.",
  "version": "0.0.0",
  "author": "Satoshi Konno",
  "bin": {
    "orbit": "./bin/run.js"
  },
  "bugs": "https://github.com/cybergarage/orbit/issues",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@oclif/core": "^4",
    "@oclif/plugin-help": "^6",
    "@types/react": "^19.2.14",
    "env-paths": "^4.0.0",
    "express": "^5.2.1",
    "fast-glob": "^3.3.3",
    "gpt-tokenizer": "^3.4.0",
    "ignore": "^5.3.2",
    "ink": "^6.8.0",
    "ollama": "^0.6.3",
    "openai": "^6.29.0",
    "pino": "^10.3.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.8",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/compat": "^1",
    "@oclif/prettier-config": "^0.2.1",
    "@oclif/test": "^4",
    "@types/chai": "^4",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10",
    "@types/node": "^20.19.43",
    "@types/react-dom": "^19.2.4",
    "@types/sinon": "^21.0.0",
    "chai": "^4",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-oclif": "^6",
    "eslint-config-prettier": "^10",
    "mocha": "^11.7.6",
    "oclif": "^4",
    "prettier": "^3.8.1",
    "shx": "^0.3.3",
    "sinon": "^21.0.2",
    "ts-node": "^10",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "./bin",
    "./dist",
    "./oclif.manifest.json"
  ],
  "homepage": "https://github.com/cybergarage/orbit",
  "keywords": [
    "oclif"
  ],
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "type": "module",
  "oclif": {
    "bin": "orbit",
    "dirname": "orbit",
    "commands": "./dist/apps/cli",
    "plugins": [
      "@oclif/plugin-help"
    ],
    "topicSeparator": " "
  },
  "overrides": {
    "mocha": {
      "diff": "^8.0.3",
      "serialize-javascript": "^7.1.0"
    }
  },
  "repository": "cybergarage/orbit",
  "scripts": {
    "build": "shx rm -rf dist && tsc -b && node ./bin/build-gui.mjs",
    "headers:apply": "node ./bin/headers.js --write",
    "headers:check": "node ./bin/headers.js",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint --fix",
    "postpack": "shx rm -f oclif.manifest.json",
    "prepack": "oclif manifest && oclif readme",
    "pretest": "npm run format && npm run lint",
    "test": "TS_NODE_PROJECT=tsconfig.test.json mocha --forbid-only \"test/**/*.test.ts\"",
    "version": "oclif readme && git add README.md"
  },
  "types": "dist/index.d.ts",
  "prettier": "@oclif/prettier-config"
}
