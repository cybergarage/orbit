{
  "name": "@cybergarage/orbit",
  "description": "A TypeScript agent framework for building agent applications.",
  "version": "0.6.1",
  "author": "Satoshi Konno",
  "bin": {
    "orbit": "./bin/run.js"
  },
  "bugs": "https://github.com/cybergarage/orbit/issues",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@oclif/core": "^4",
    "@oclif/plugin-help": "^6",
    "@types/react": "^19.2.14",
    "better-sqlite3": "12.11.1",
    "env-paths": "^4.0.0",
    "express": "^5.2.1",
    "fast-glob": "^3.3.3",
    "gpt-tokenizer": "^3.4.0",
    "ignore": "^5.3.2",
    "ink": "^6.8.0",
    "ollama": "^0.6.3",
    "openai": "^6.29.0",
    "pino": "^10.3.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.8",
    "uuid": "^14.0.0",
    "yaml": "2.9.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/compat": "^1",
    "@oclif/prettier-config": "^0.2.1",
    "@oclif/test": "^4",
    "@types/better-sqlite3": "9.6.0",
    "@types/chai": "^4",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10",
    "@types/node": "^20.19.43",
    "@types/react-dom": "^19.2.4",
    "@types/sinon": "^21.0.0",
    "chai": "^4",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-oclif": "^6",
    "eslint-config-prettier": "^10",
    "mocha": "^11.7.6",
    "oclif": "^4",
    "prettier": "^3.8.1",
    "shx": "^0.3.3",
    "sinon": "^21.0.2",
    "ts-node": "^10",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "CHANGELOG.md",
    "bin/run.js",
    "bin/run.cmd",
    "bin/args.js",
    "dist",
    "oclif.manifest.json",
    "docs/*.md",
    "examples/agent/src",
    "examples/agent/package.json",
    "examples/agent/tsconfig.json",
    "examples/agent/README.md"
  ],
  "homepage": "https://github.com/cybergarage/orbit",
  "keywords": [
    "ai",
    "agent",
    "typescript",
    "mcp",
    "agent-framework",
    "cli"
  ],
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "type": "module",
  "oclif": {
    "bin": "orbit",
    "dirname": "orbit",
    "commands": "./dist/apps/cli",
    "plugins": [
      "@oclif/plugin-help"
    ],
    "topicSeparator": " ",
    "repositoryPrefix": "<%- repo %>/blob/v<%- version %>/src/apps/cli/<%- c.id.split(':').join('/') %>.ts"
  },
  "overrides": {
    "mocha": {
      "diff": "^8.0.3",
      "serialize-javascript": "^7.1.0"
    }
  },
  "repository": "cybergarage/orbit",
  "scripts": {
    "build": "shx rm -rf dist && tsc -b && node ./bin/build-gui.mjs",
    "headers:apply": "node ./bin/headers.js --base src,test,examples/agent/src --write",
    "headers:check": "node ./bin/headers.js --base src,test,examples/agent/src",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint --fix",
    "postpack": "shx rm -f oclif.manifest.json",
    "prepack": "npm run build && oclif manifest",
    "pretest": "npm run format && npm run lint",
    "test": "TS_NODE_PROJECT=tsconfig.test.json mocha --forbid-only \"test/**/*.test.ts\"",
    "version": "npm run docs:commands && git add docs/cli.md",
    "docs:commands": "oclif manifest && oclif readme --readme-path docs/cli.md",
    "test:package": "node bin/test-package.mjs",
    "test:e2e:ollama": "mocha --no-config --no-package --forbid-only e2e/small.e2e.mjs",
    "test:e2e:unit": "mocha --no-config --no-package --forbid-only e2e/host.test.mjs",
    "e2e:build": "docker build -f e2e/Dockerfile -t orbit-e2e:local .",
    "eval:swebench": "node e2e/swebench.mjs",
    "test:e2e:graders": "mocha --no-config --no-package --forbid-only e2e/graders.e2e.mjs"
  },
  "types": "dist/index.d.ts",
  "prettier": "@oclif/prettier-config",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
